# ── Copy this file to .env and fill in your values ────────
# Never commit .env to git!

# AQICN API
# Get your free key at: https://aqicn.org/api/
AQICN_API_KEY=your_aqicn_api_key_here

# OpenWeatherMap API
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Hopsworks
# Sign up free at: https://www.hopsworks.ai/
# Find your API key under: Account → API Keys
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT_NAME=your_project_name_here

# Target city for AQI prediction
CITY_NAME=London
CITY_LAT=51.5074
CITY_LON=-0.1278
